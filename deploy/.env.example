# OpenAI-compatible model provider. Use a dedicated, low-spend demo key.
LLM_API_KEY=
LLM_MODEL=openai/gpt-5-mini
LLM_BASE_URL=https://openrouter.ai/api/v1

# The demo API owns these values. They are never accepted from the browser.
DEMO_MODE=true
DEMO_SITE_ID=4
DEMO_USER_ID=1
DEMO_CURRENT_DATE=2026-07-31
# Set this to the exact public frontend origin, without a trailing slash.
OMAI_CORS_ALLOWED_ORIGINS=https://demo.example.com
OMAI_DAILY_USER_LIMIT_ENABLED=true
# This is a global daily limit until access-code authentication is added.
OMAI_DAILY_USER_LIMIT_REQUESTS=50
OMAI_MAX_CONCURRENT=2
OMAI_SLOT_TIMEOUT=15
OMAI_CONVERSATION_HISTORY_LIMIT=20
OMAI_CONVERSATION_TTL_HOURS=24
TIMEZONE=UTC
LOG_LEVEL=INFO

DB_HOST=mariadb
DB_PORT=3306
DB_NAME=ometrics_demo
DB_USER=omai_app
DB_PASSWORD=change-me-omai-app
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800
OPERATIONAL_SQL_DB_USER=omai_sql_readonly
OPERATIONAL_SQL_DB_PASSWORD=change-me-omai-readonly
OPERATIONAL_SQL_MAX_ROWS=100
OPERATIONAL_SQL_TIMEOUT_SECONDS=10

MYSQL_DATABASE=ometrics_demo
MYSQL_USER=omai_app
MYSQL_PASSWORD=change-me-omai-app
MYSQL_ROOT_PASSWORD=change-me-mariadb-root

VECTOR_DB_HOST=postgres
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=ometrics_demo
VECTOR_DB_USER=ometrics
VECTOR_DB_PASSWORD=change-me-postgres
VECTOR_DB_POOL_SIZE=5
VECTOR_DB_MAX_OVERFLOW=2
VECTOR_DB_POOL_TIMEOUT=15
VECTOR_DB_POOL_RECYCLE=1800
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536

OMREPORTS_API_URL=http://omreports:50008/report/
OMREPORTS_TIMEOUT_SECONDS=30
MAX_REPORT_DAYS=366
MONITORING_DATA_API_URL=http://graphite/render
DATA_POINT_TREND_TIMEOUT_SECONDS=20
DATA_POINT_TREND_MAX_DATA_POINTS=300
ROD_PUMP_TIMEOUT_SECONDS=20
ROD_PUMP_MAX_DATA_POINTS=96
ROD_PUMP_BATCH_WORKERS=2
ROD_PUMP_MODEL_METADATA=

# The Omreports source directory is a sibling checkout by default. Override it
# when the deployment checkout uses another layout.
OMREPORTS_SOURCE_DIR=../../omreports
